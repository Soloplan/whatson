<Page x:Class="Soloplan.WhatsON.GUI.Configuration.Wizard.ProjectSelectionWizardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:Soloplan.WhatsON.Localization;assembly=Soloplan.WhatsON"
      xmlns:live="clr-namespace:Soloplan.WhatsON.GUI.Common.Localization;assembly=Soloplan.WhatsON.GUI.Common"
      xmlns:wizard="clr-namespace:Soloplan.WhatsON.GUI.Configuration.Wizard"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="{live:Text loc:Strings.ChooseProjects}" Background="Transparent" FontFamily="Segoe UI" FontSize="14"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,20,0">
        <TextBlock Text="{live:Text loc:Strings.ChooseProjects}" Style="{StaticResource SettingsHeading}" />
        <TextBlock Text="{Binding ProposedServerAddress}" Style="{StaticResource SettingsDescription}"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
      </StackPanel>
      <TextBox x:Name="searchTextBox" Grid.Column="1" VerticalAlignment="Center"
               materialDesign:HintAssist.Hint="{live:Text loc:Strings.FilterProjectFolder}"
               Text="{Binding DataContext.SearchText, ElementName=projectsTreeView, UpdateSourceTrigger=PropertyChanged, Delay=250}"
               AutomationProperties.Name="{live:Text loc:Strings.FilterProjectFolder}" />
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource SettingsCard}" Padding="12">
      <Grid>
        <wizard:ProjectsTreeView x:Name="projectsTreeView"
                                 KeyDown="ProjectsKeyDown">
          <wizard:ProjectsTreeView.Style>
            <Style TargetType="wizard:ProjectsTreeView"><Style.Triggers>
              <DataTrigger Binding="{Binding DataContext.Projects.Count, RelativeSource={RelativeSource AncestorType=Page}}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers></Style>
          </wizard:ProjectsTreeView.Style>
        </wizard:ProjectsTreeView>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Projects.Count}" Value="0">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="{live:Text loc:Strings.NoProjectsFound}" FontWeight="SemiBold" TextAlignment="Center"
                     Margin="0,0,0,6" />
          <TextBlock Text="{live:Text loc:Strings.CheckAddressDescription}"
                     Style="{StaticResource SettingsDescription}" TextAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource SettingsCard}" Margin="0" Padding="12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition /><ColumnDefinition Width="230" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{live:Text loc:Strings.OrganizeProjects}" FontWeight="SemiBold" VerticalAlignment="Center"
                   Margin="0,0,16,0" />
        <ComboBox x:Name="uxGrouppingSettings" Grid.Column="1" MinHeight="36" DisplayMemberPath="Caption"
                  ItemsSource="{Binding GroupingSettings}" IsSynchronizedWithCurrentItem="True"
                  Loaded="UxGrouppingSettingsLoaded" SelectedItem="{Binding SelectedGroupingSetting, Mode=TwoWay}"
                  AutomationProperties.Name="{live:Text loc:Strings.OrganizeProjects}" />
      </Grid>
    </Border>
  </Grid>
</Page>
