<Page x:Class="Soloplan.WhatsON.GUI.Configuration.Wizard.ProjectSelectionWizardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:Soloplan.WhatsON.Localization;assembly=Soloplan.WhatsON"
      xmlns:wizard="clr-namespace:Soloplan.WhatsON.GUI.Configuration.Wizard"
      Title="{x:Static loc:Strings.ChooseProjects}" Background="Transparent" FontFamily="Segoe UI" FontSize="14"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20">
      <TextBlock Text="{x:Static loc:Strings.ChooseProjects}" Style="{StaticResource SettingsHeading}" />
      <TextBlock Text="{Binding ProposedServerAddress}" Style="{StaticResource SettingsDescription}" />
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource SettingsCard}" Padding="16">
      <StackPanel>
        <Label Content="{x:Static loc:Strings.FindProject}" Target="{Binding ElementName=searchTextBox}" Padding="0" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBox x:Name="searchTextBox" MinHeight="36" TextChanged="SearchTextBoxTextChanged" AutomationProperties.Name="{x:Static loc:Strings.FindProject}" />
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource SettingsCard}" Padding="12">
      <Grid>
        <wizard:ProjectsTreeView x:Name="projectsTreeView" DataContext="{Binding Projects}"
                                 PreviewKeyUp="MainTreeViewPreviewKeyUp" />
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Projects.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="{x:Static loc:Strings.NoProjectsFound}" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,6" />
          <TextBlock Text="{x:Static loc:Strings.CheckAddressDescription}"
                     Style="{StaticResource SettingsDescription}" TextAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="3" Style="{StaticResource SettingsCard}" Margin="0" Padding="16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
        <TextBlock Text="{x:Static loc:Strings.OrganizeProjects}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
        <ComboBox x:Name="uxGrouppingSettings" Grid.Column="1" MinHeight="36" DisplayMemberPath="Caption"
                  ItemsSource="{Binding GroupingSettings}" IsSynchronizedWithCurrentItem="True"
                  Loaded="UxGrouppingSettingsLoaded" SelectedItem="{Binding SelectedGroupingSetting, Mode=TwoWay}"
                  AutomationProperties.Name="{x:Static loc:Strings.OrganizeProjects}" />
      </Grid>
    </Border>
  </Grid>
</Page>
