<Window x:Class="Soloplan.WhatsON.GUI.Configuration.Wizard.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Soloplan.WhatsON.Localization;assembly=Soloplan.WhatsON"
        xmlns:live="clr-namespace:Soloplan.WhatsON.GUI.Common.Localization;assembly=Soloplan.WhatsON.GUI.Common"
        xmlns:gui="clr-namespace:Soloplan.WhatsON.GUI"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:wizard="clr-namespace:Soloplan.WhatsON.GUI.Configuration.Wizard"
        Title="{live:Text loc:Strings.AddProjects}" Width="760" Height="680" MinWidth="600" MinHeight="600"
        Background="{DynamicResource SettingsBackground}" FontFamily="Segoe UI" FontSize="14"
        ShowInTaskbar="False" Style="{StaticResource BorderLessWindowStyle}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
  <Border Background="{DynamicResource SettingsBackground}" BorderBrush="{DynamicResource SettingsBorder}"
          BorderThickness="1">
    <DockPanel>
      <gui:CustomTitleBar x:Name="Header" DockPanel.Dock="Top" CustomButtonVisible="False" ShowMinimizeButton="False"
                          Window="{Binding RelativeSource={RelativeSource AncestorType={x:Type wizard:WizardWindow}}}" />
      <materialDesign:DialogHost x:Name="WizardWaitDialogHost" Identifier="WizardWaitDialogHostId"
                                 DialogTheme="Inherit" DialogBackground="{DynamicResource SettingsSurface}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="24,20,24,20">
            <Border CornerRadius="6" Padding="12,8">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="TextElement.Foreground" Value="{DynamicResource SettingsMuted}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLastStep}" Value="False">
                      <Setter Property="Background" Value="{DynamicResource SettingsSelection}" />
                      <Setter Property="TextElement.Foreground" Value="{DynamicResource SettingsAccent}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="{live:Text loc:Strings.ConnectionStep}" FontWeight="SemiBold" FontSize="13" />
            </Border>
            <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18" Margin="12,0"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource SettingsMuted}" />
            <Border CornerRadius="6" Padding="12,8">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="TextElement.Foreground" Value="{DynamicResource SettingsMuted}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource SettingsSelection}" />
                      <Setter Property="TextElement.Foreground" Value="{DynamicResource SettingsAccent}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="{live:Text loc:Strings.ProjectsStep}" FontWeight="SemiBold" FontSize="13" />
            </Border>
          </StackPanel>
          <Frame x:Name="Frame" Grid.Row="1" Margin="24,0,24,20" NavigationUIVisibility="Hidden" />
          <Border Grid.Row="2" Background="{DynamicResource SettingsSurface}"
                  BorderBrush="{DynamicResource SettingsBorder}"
                  BorderThickness="0,1,0,0" Padding="24,16">
            <DockPanel LastChildFill="False">
              <Button Content="{live:Text loc:Strings.Cancel}" DockPanel.Dock="Left" IsCancel="True"
                      Style="{StaticResource SettingsSecondaryButton}" />
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BackButton" Content="{live:Text loc:Strings.Back}" Click="PrevClick"
                        IsEnabled="{Binding IsPreviousStepEnabled}"
                        Margin="0,0,10,0" Style="{StaticResource SettingsSecondaryButton}" />
                <Button x:Name="NextButton" Content="{live:Text loc:Strings.Next}" Click="NextClick"
                        IsEnabled="{Binding IsNextStepEnabled}"
                        Visibility="{Binding IsNotLastStep, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource SettingsPrimaryButton}" />
                <Button x:Name="FinishButton" Content="{live:Text loc:Strings.AddSelectedProjects}" Click="FinishClick"
                        IsEnabled="{Binding IsAnyProjectChecked}"
                        Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource SettingsPrimaryButton}" />
              </StackPanel>
            </DockPanel>
          </Border>
        </Grid>
      </materialDesign:DialogHost>
    </DockPanel>
  </Border>
</Window>