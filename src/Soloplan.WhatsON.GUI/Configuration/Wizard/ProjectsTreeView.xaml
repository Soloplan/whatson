<UserControl x:Class="Soloplan.WhatsON.GUI.Configuration.Wizard.ProjectsTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:loc="clr-namespace:Soloplan.WhatsON.Localization;assembly=Soloplan.WhatsON"
             xmlns:live="clr-namespace:Soloplan.WhatsON.GUI.Common.Localization;assembly=Soloplan.WhatsON.GUI.Common"
             xmlns:local="clr-namespace:Soloplan.WhatsON.GUI.Configuration.Wizard"
             xmlns:wpf="clr-namespace:TheArtOfDev.HtmlRenderer.WPF;assembly=HtmlRenderer.WPF"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent" FontFamily="Segoe UI" FontSize="14"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}" PreviewKeyDown="ProjectsPreviewKeyDown">
  <UserControl.Resources>
    <sys:Double x:Key="ProjectColumnWidth">300</sys:Double>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <local:WizardProjectToVisibilityConverter x:Key="ProjectTooltipVisibility" />
    <Style x:Key="ProjectRow" TargetType="ListBoxItem" BasedOn="{StaticResource SettingsNavigationItem}">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,2,8,2" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsChecked}" Value="True"><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <DataTemplate x:Key="ProjectEntry">
      <Grid MinHeight="32">
        <Grid.ToolTip>
          <ToolTip Visibility="{Binding Converter={StaticResource ProjectTooltipVisibility}}"
                   Background="{DynamicResource SettingsSurface}" Foreground="{DynamicResource MaterialDesignBody}"
                   BorderBrush="{DynamicResource SettingsBorder}" Padding="12">
            <wpf:HtmlPanel ImageLoad="DescriptionImageLoad" Background="Transparent" MaxWidth="420">
              <wpf:HtmlPanel.Text>
                <MultiBinding StringFormat='{}&lt;font face=&quot;Segoe UI&quot; color=&quot;{1}&quot;&gt;{0}&lt;/font&gt;'>
                  <Binding Path="Description" />
                  <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=ToolTip}" Converter="{StaticResource RGBAToRGBConverter}" />
                </MultiBinding>
              </wpf:HtmlPanel.Text>
            </wpf:HtmlPanel>
          </ToolTip>
        </Grid.ToolTip>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <CheckBox IsChecked="{Binding SelectionState}" IsEnabled="{Binding IsCheckable}" VerticalAlignment="Center" Margin="0,0,10,0"
                  AutomationProperties.Name="{Binding ProjectPath}" />
        <StackPanel Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center">
          <DockPanel>
            <materialDesign:PackIcon Kind="FolderOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                     Foreground="{DynamicResource SettingsMuted}"
                                     Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SettingsMuted}"
                     Visibility="{Binding AlreadyAdded, Converter={StaticResource BoolToVisibility}}">
            <Run Text="{live:Text loc:Strings.AlreadyAddedPrefix}" /><Run Text="{Binding AddedProject, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
        <Button Grid.Column="2" Width="24" Style="{StaticResource HeaderIconButton}" Click="OpenFolderClick"
                ToolTip="{live:Text loc:Strings.OpenProjectFolder}" AutomationProperties.Name="{live:Text loc:Strings.OpenProjectFolder}"
                Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisibility}}">
          <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18" />
        </Button>
        <Button Grid.Column="2" Width="24" Click="OpenProjectClick"
                ToolTip="{live:Text loc:Strings.OpenProjectInBrowser}" AutomationProperties.Name="{live:Text loc:Strings.OpenProjectInBrowser}">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource HeaderIconButton}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding DirectAddress}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding DirectAddress}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <materialDesign:PackIcon Kind="OpenInNew" Width="16" Height="16" />
        </Button>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
    <DockPanel Margin="12,4,12,12">
      <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource SettingsMuted}" FontSize="12">
        <Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=" " /><Run Text="{live:Text loc:Strings.ProjectsSelected}" />
      </TextBlock>
      <CheckBox x:Name="SelectAllProjects" Content="{live:Text loc:Strings.SelectAllProjects}"
                IsChecked="{Binding AllSelectionState}" IsEnabled="{Binding HasSelectableProjects}"
                ToolTip="{live:Text loc:Strings.SelectAllProjectsDescription}"
                Visibility="{Binding MultiSelectionMode, Converter={StaticResource BoolToVisibility}}" />
    </DockPanel>
    <ScrollViewer x:Name="ColumnsScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                  CanContentScroll="False" SizeChanged="ColumnsSizeChanged" Padding="0,0,0,8">
      <ItemsControl x:Name="ColumnsPanel" ItemsSource="{Binding Columns}" SizeChanged="ColumnsSizeChanged">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="{DynamicResource ProjectColumnWidth}" Padding="8,0" BorderBrush="{DynamicResource SettingsBorder}" Loaded="ColumnLoaded">
              <Border.Style><Style TargetType="Border"><Setter Property="BorderThickness" Value="0,0,1,0" /><Style.Triggers>
                <DataTrigger Binding="{Binding IsLast}" Value="True"><Setter Property="BorderThickness" Value="0" /></DataTrigger>
              </Style.Triggers></Style></Border.Style>
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                <TextBlock Text="{Binding Folder.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="8,0,8,8"
                           ToolTip="{Binding Folder.ProjectPath}" />
                <TextBlock Text="{live:Text loc:Strings.ProjectServerRoot}" FontWeight="SemiBold" Margin="8,0,8,8">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                    <DataTrigger Binding="{Binding Folder}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                  </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <ListBox Grid.Row="1" ItemsSource="{Binding VisibleProjects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource ProjectRow}"
                         ItemTemplate="{StaticResource ProjectEntry}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="{live:Text loc:Strings.AvailableProjects}" />
                <TextBlock Grid.Row="1" Text="{live:Text loc:Strings.NoMatchingProjects}" TextWrapping="Wrap" Margin="8,20"
                           Foreground="{DynamicResource SettingsMuted}" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                    <DataTrigger Binding="{Binding HasVisibleProjects}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                  </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
