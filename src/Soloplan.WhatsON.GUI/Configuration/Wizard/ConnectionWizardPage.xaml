<Page x:Class="Soloplan.WhatsON.GUI.Configuration.Wizard.ConnectionWizardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:Soloplan.WhatsON.Localization;assembly=Soloplan.WhatsON"
      Title="{x:Static loc:Strings.ConnectBuildServer}" Background="Transparent" FontFamily="Segoe UI" FontSize="14"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Style="{StaticResource SettingsScrollContent}">
      <TextBlock Text="{x:Static loc:Strings.ConnectBuildServer}" Style="{StaticResource SettingsHeading}" />
      <TextBlock Text="{x:Static loc:Strings.EnterServerAddressDescription}"
                 Style="{StaticResource SettingsDescription}" Margin="0,0,0,22" />
      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <TextBlock Text="{x:Static loc:Strings.ServerConnection}" Style="{StaticResource SettingsSectionHeading}" />
          <Label Content="{x:Static loc:Strings.ServerOrProjectURL}" Target="{Binding ElementName=AddressComboBox}" Padding="0" FontWeight="SemiBold" Margin="0,0,0,8" />
          <ComboBox x:Name="AddressComboBox" MinHeight="40" IsEditable="True"
                    ItemsSource="{Binding AvailableServers, Mode=OneWay}"
                    Text="{Binding ProposedServerAddress}"
                    KeyUp="ConnectionAdressKeyUp" AutomationProperties.Name="{x:Static loc:Strings.ServerOrProjectURL}" />
          <TextBlock Text="{x:Static loc:Strings.ServerAddressHelp}"
                     Style="{StaticResource SettingsDescription}" Margin="0,8,0,20" />
          <CheckBox x:Name="AutoDetectionCheckbox" Content="{x:Static loc:Strings.DetectBuildSystemAutomatically}"
                    IsChecked="{Binding IsAutoDetectionEnabled, Mode=TwoWay}" />
          <StackPanel Margin="0,20,0,0" Visibility="{Binding IsAutoDetectionDisabled, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{x:Static loc:Strings.BuildSystem}" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ComboBox MinHeight="40" DisplayMemberPath="DisplayName" ItemsSource="{Binding AvailableConnectorTypes}"
                      SelectedItem="{Binding SelectedConnectorType, Mode=TwoWay}" AutomationProperties.Name="{x:Static loc:Strings.BuildSystem}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <TextBlock Text="{x:Static loc:Strings.WizardChangesDescription}"
                 Style="{StaticResource SettingsDescription}" />
    </StackPanel>
  </ScrollViewer>
</Page>