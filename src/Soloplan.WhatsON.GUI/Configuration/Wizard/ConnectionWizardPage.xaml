<Page x:Class="Soloplan.WhatsON.GUI.Configuration.Wizard.ConnectionWizardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Connect a build server" Background="Transparent" FontFamily="Segoe UI" FontSize="14"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Style="{StaticResource SettingsScrollContent}">
      <TextBlock Text="Connect a build server" Style="{StaticResource SettingsHeading}" />
      <TextBlock Text="Enter a Jenkins or CruiseControl.NET address to discover your projects."
                 Style="{StaticResource SettingsDescription}" Margin="0,0,0,22" />
      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <TextBlock Text="Server connection" Style="{StaticResource SettingsSectionHeading}" />
          <Label Content="Server or project URL" Target="{Binding ElementName=AddressComboBox}" Padding="0" FontWeight="SemiBold" Margin="0,0,0,8" />
          <ComboBox x:Name="AddressComboBox" MinHeight="40" IsEditable="True"
                    ItemsSource="{Binding AvailableServers, Mode=OneWay}"
                    Text="{Binding ProposedServerAddress}"
                    KeyUp="ConnectionAdressKeyUp" AutomationProperties.Name="Server or project URL" />
          <TextBlock Text="Use a server address or a direct link to a project."
                     Style="{StaticResource SettingsDescription}" Margin="0,8,0,20" />
          <CheckBox x:Name="AutoDetectionCheckbox" Content="Detect build system automatically"
                    IsChecked="{Binding IsAutoDetectionEnabled, Mode=TwoWay}" />
          <StackPanel Margin="0,20,0,0" Visibility="{Binding IsAutoDetectionDisabled, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Build system" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ComboBox MinHeight="40" DisplayMemberPath="DisplayName" ItemsSource="{Binding AvailableConnectorTypes}"
                      SelectedItem="{Binding SelectedConnectorType, Mode=TwoWay}" AutomationProperties.Name="Build system" />
          </StackPanel>
        </StackPanel>
      </Border>
      <TextBlock Text="Your existing projects and settings stay unchanged until you finish the wizard."
                 Style="{StaticResource SettingsDescription}" />
    </StackPanel>
  </ScrollViewer>
</Page>