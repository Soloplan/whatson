<UserControl x:Class="Soloplan.WhatsON.GUI.Configuration.View.CreateEditConnectorDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Soloplan.WhatsON.Localization;assembly=Soloplan.WhatsON"
             xmlns:live="clr-namespace:Soloplan.WhatsON.GUI.Common.Localization;assembly=Soloplan.WhatsON.GUI.Common"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:whatsOn="clr-namespace:Soloplan.WhatsON.Composition;assembly=Soloplan.WhatsON"
             FontFamily="Segoe UI" FontSize="14" TextElement.Foreground="{DynamicResource MaterialDesignBody}">
  <Border Style="{StaticResource SettingsDialog}">
    <StackPanel>
      <TextBlock Text="{live:Text loc:Strings.ProjectDetails}" Style="{StaticResource SettingsSectionHeading}" />
      <TextBlock Text="{live:Text loc:Strings.ChooseBuildSystemDescription}"
                 Style="{StaticResource SettingsDescription}" Margin="0,0,0,20" />
      <Label Content="{live:Text loc:Strings.BuildSystem}" Target="{Binding ElementName=uxPluginType}" Padding="0"
             FontWeight="SemiBold" Margin="0,0,0,6" />
      <ComboBox x:Name="uxPluginType" MinHeight="40" DisplayMemberPath="DisplayName" Margin="0,0,0,16"
                ItemsSource="{Binding ConnectorPlugins, Source={x:Static whatsOn:PluginManager.Instance}}"
                AutomationProperties.Name="{live:Text loc:Strings.BuildSystem}" />
      <Label Content="{live:Text loc:Strings.ProjectName}" Target="{Binding ElementName=uxEditConnectorName}"
             Padding="0" FontWeight="SemiBold" Margin="0,0,0,6" />
      <TextBox x:Name="uxEditConnectorName" MinHeight="40"
               AutomationProperties.Name="{live:Text loc:Strings.ProjectName}"
               Text="{Binding CurrentConnector.Name, UpdateSourceTrigger=Explicit}" />
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,24,0,0">
        <Button Content="{live:Text loc:Strings.Cancel}" Click="CancelButtonClick" IsCancel="True" Margin="0,0,10,0"
                Command="materialDesign:DialogHost.CloseDialogCommand" Style="{StaticResource SettingsSecondaryButton}">
          <Button.CommandParameter>
            <system:Boolean>False</system:Boolean>
          </Button.CommandParameter>
        </Button>
        <Button Content="{live:Text loc:Strings.Confirm}" Click="OkButtonClick" IsDefault="True"
                Command="materialDesign:DialogHost.CloseDialogCommand" Style="{StaticResource SettingsPrimaryButton}">
          <Button.CommandParameter>
            <system:Boolean>True</system:Boolean>
          </Button.CommandParameter>
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>