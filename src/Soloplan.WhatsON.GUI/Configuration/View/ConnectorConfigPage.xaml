<Page x:Class="Soloplan.WhatsON.GUI.Configuration.View.ConnectorConfigPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:Soloplan.WhatsON.Localization;assembly=Soloplan.WhatsON"
      xmlns:live="clr-namespace:Soloplan.WhatsON.GUI.Common.Localization;assembly=Soloplan.WhatsON.GUI.Common"
      Title="{live:Text loc:Strings.ProjectSettings}" Background="Transparent" FontFamily="Segoe UI" FontSize="14"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}">
  <Grid x:Name="MainGrid">
    <Border Style="{StaticResource SettingsCard}" Margin="0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{StaticResource SettingsScrollContent}">
          <TextBlock Text="{live:Text loc:Strings.ProjectSettings}" Style="{StaticResource SettingsSectionHeading}" />
          <StackPanel x:Name="StackPanel" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Page>