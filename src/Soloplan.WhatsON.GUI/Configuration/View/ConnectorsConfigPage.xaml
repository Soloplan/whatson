<Page x:Class="Soloplan.WhatsON.GUI.Configuration.View.ConnectorsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Projects" FontFamily="Segoe UI" FontSize="14" Background="Transparent" Initialized="PageInitialized"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}">
  <materialDesign:DialogHost Identifier="ConnectorsConfigPageHost" Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
    <Grid Margin="0,0,8,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,22">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                    Visibility="{Binding SingleConnectorMode, Converter={StaticResource InvertBoolToVis}}">
          <Button x:Name="AddButton" Content="Add manually" Click="AddConnectorClick"
                  Style="{StaticResource SettingsSecondaryButton}" Margin="0,0,10,0" />
          <Button x:Name="WizardButton" Content="Add project" Click="NewInWizardClick"
                  Style="{StaticResource SettingsPrimaryButton}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Projects" Style="{StaticResource SettingsHeading}" />
          <TextBlock Text="Manage the builds and servers you monitor." Style="{StaticResource SettingsDescription}" />
        </StackPanel>
      </DockPanel>
      <StackPanel Grid.Row="1">
        <TextBox x:Name="uxName" Margin="0,0,0,20" MinHeight="40"
                 materialDesign:HintAssist.Hint="Project name" AutomationProperties.Name="Project name"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 Visibility="{Binding SingleConnectorMode, Converter={StaticResource BoolToVis}}" />
        <Border>
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource SettingsCard}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Connectors.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding SingleConnectorMode}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel>
            <TextBlock Text="Selected project" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ComboBox x:Name="uxConnectors" MinHeight="40" DisplayMemberPath="FullName"
                      ItemsSource="{Binding Connectors}" SelectedItem="{Binding CurrentConnector, Mode=TwoWay}"
                      IsSynchronizedWithCurrentItem="True" SelectionChanged="ConnectorsSelectionChanged"
                      AutomationProperties.Name="Selected project" />
            <WrapPanel Margin="0,16,0,0">
              <Button x:Name="RenameButtton" Content="Rename" Click="RenameConnectorClick" Margin="0,0,8,0"
                      Style="{StaticResource SettingsSecondaryButton}"
                      IsEnabled="{Binding CurrentConnectorIsNull, Converter={StaticResource InvertBoolConverter}}" />
              <Button x:Name="DeleteButton" Content="Remove" Click="DeleteConnectorClick"
                      Style="{StaticResource SettingsSecondaryButton}"
                      IsEnabled="{Binding CurrentConnectorIsNull, Converter={StaticResource InvertBoolConverter}}" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
      <Grid Grid.Row="2">
        <Border x:Name="EmptyProjectsState" VerticalAlignment="Top" Padding="28,44">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource SettingsCard}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Connectors.Count}" Value="0" />
                    <Condition Binding="{Binding SingleConnectorMode}" Value="False" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel HorizontalAlignment="Center" MaxWidth="390">
            <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource SettingsSelection}" Margin="0,0,0,20">
              <materialDesign:PackIcon Kind="Server" Width="32" Height="32" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource SettingsAccent}" />
            </Border>
            <TextBlock Text="Your builds, in one place" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
            <TextBlock Text="Add a Jenkins or CruiseControl.NET project to start monitoring build status and receiving notifications."
                       TextAlignment="Center" Style="{StaticResource SettingsDescription}" Margin="0,10,0,0" />
            <TextBlock Text="Choose Add project above to connect your first build."
                       TextAlignment="Center" Style="{StaticResource SettingsDescription}" Margin="0,16,0,0" />
          </StackPanel>
        </Border>
        <Frame x:Name="uxConnectorFrame" NavigationUIVisibility="Hidden">
          <Frame.Style>
            <Style TargetType="Frame">
              <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentConnectorIsNull}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </Frame.Style>
        </Frame>
      </Grid>
    </Grid>
  </materialDesign:DialogHost>
</Page>
