<Window x:Class="Soloplan.WhatsON.GUI.Configuration.View.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Soloplan.WhatsON.Localization;assembly=Soloplan.WhatsON"
        xmlns:live="clr-namespace:Soloplan.WhatsON.GUI.Common.Localization;assembly=Soloplan.WhatsON.GUI.Common"
        xmlns:gui="clr-namespace:Soloplan.WhatsON.GUI"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:view="clr-namespace:Soloplan.WhatsON.GUI.Configuration.View"
        Title="{live:Text loc:Strings.Settings}" Width="1000" Height="780" MinWidth="800" MinHeight="580"
        Background="{DynamicResource SettingsBackground}" FontFamily="Segoe UI"
        TextElement.FontSize="14" TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Closing="WindowClosing" ShowInTaskbar="False" Style="{StaticResource BorderLessWindowStyle}">
  <Border Background="{DynamicResource SettingsBackground}" BorderBrush="{DynamicResource SettingsBorder}"
          BorderThickness="1">
    <DockPanel>
      <gui:CustomTitleBar DockPanel.Dock="Top" CustomButtonVisible="False" ShowMinimizeButton="False"
                          Window="{Binding RelativeSource={RelativeSource AncestorType={x:Type view:ConfigWindow}}}" />
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition>
            <ColumnDefinition.Style>
              <Style TargetType="ColumnDefinition">
                <Setter Property="Width" Value="190" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SingleConnectorMode}" Value="True">
                    <Setter Property="Width" Value="0" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ColumnDefinition.Style>
          </ColumnDefinition>
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.RowSpan="2" Background="{DynamicResource SettingsSurface}"
                BorderBrush="{DynamicResource SettingsBorder}"
                BorderThickness="0,0,1,0"
                Visibility="{Binding SingleConnectorMode, Converter={StaticResource InvertBoolToVis}}">
          <DockPanel Margin="12,16,12,12">
            <TextBlock DockPanel.Dock="Top" Text="{live:Text loc:Strings.SettingsUppercase}" FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource SettingsMuted}" Margin="12,0,0,12" />
            <TextBlock DockPanel.Dock="Bottom" Text="whatsON" Margin="12,12,0,0"
                       Foreground="{DynamicResource SettingsMuted}" FontSize="12" />
            <ListBox x:Name="ConfigTopicsListBox" BorderThickness="0" Background="Transparent"
                     ItemContainerStyle="{StaticResource SettingsNavigationItem}"
                     SelectedItem="{Binding InitialFocusedConfigurationListBoxItem, Mode=OneWay}"
                     SelectionChanged="ListBoxSelectionChanged"
                     AutomationProperties.Name="{live:Text loc:Strings.SettingsSections}">
              <ListBoxItem Tag="{x:Static view:ConfigWindow.MainListItemTag}"
                           AutomationProperties.Name="{live:Text loc:Strings.General}">
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon Kind="Tune" Width="20" Height="20" Margin="0,0,12,0" />
                  <TextBlock Text="{live:Text loc:Strings.General}" VerticalAlignment="Center" />
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="{x:Static view:ConfigWindow.ConnectorsListItemTag}"
                           AutomationProperties.Name="{live:Text loc:Strings.Projects}">
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon Kind="Server" Width="20" Height="20" Margin="0,0,12,0" />
                  <TextBlock Text="{live:Text loc:Strings.Projects}" VerticalAlignment="Center" />
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="{x:Static view:ConfigWindow.ServersListItemTag}"
                           AutomationProperties.Name="{live:Text loc:Strings.Servers}">
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon Kind="Key" Width="20" Height="20" Margin="0,0,12,0" />
                  <TextBlock Text="{live:Text loc:Strings.Servers}" VerticalAlignment="Center" />
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="{x:Static view:ConfigWindow.AboutListItemTag}"
                           AutomationProperties.Name="{live:Text loc:Strings.About}">
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon Kind="InformationOutline" Width="20" Height="20" Margin="0,0,12,0" />
                  <TextBlock Text="{live:Text loc:Strings.About}" VerticalAlignment="Center" />
                </StackPanel>
              </ListBoxItem>
            </ListBox>
          </DockPanel>
        </Border>
        <Frame x:Name="ConfigFrame" Grid.Column="1" Margin="20,16,8,0"
               NavigationUIVisibility="Hidden" Background="Transparent" />
        <Border x:Name="HideableStackPanel" Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingsFooter}"
                Visibility="{Binding ConfigurationIsModified, Converter={StaticResource BoolToVis}}">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="ResetButton" Click="SnackbarResetClick" Margin="0,0,10,0">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource SettingsSecondaryButton}">
                    <Setter Property="Content" Value="{live:Text loc:Strings.Reset}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SingleNewConnectorMode}" Value="True">
                        <Setter Property="Content" Value="{live:Text loc:Strings.Cancel}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <Button x:Name="SaveButton" Content="{live:Text loc:Strings.SaveChanges}" Click="SnackbarSaveClickAsync"
                      Style="{StaticResource SettingsPrimaryButton}" />
            </StackPanel>
            <TextBlock Text="{live:Text loc:Strings.UnsavedChanges}" VerticalAlignment="Center"
                       Foreground="{DynamicResource SettingsMuted}" FontSize="12" />
          </DockPanel>
        </Border>
      </Grid>
    </DockPanel>
  </Border>
</Window>