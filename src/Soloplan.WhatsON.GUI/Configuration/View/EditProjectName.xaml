<UserControl x:Class="Soloplan.WhatsON.GUI.Configuration.View.EditProjectName"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:configuration="clr-namespace:Soloplan.WhatsON.GUI.Configuration"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             FontFamily="Segoe UI" FontSize="14" TextElement.Foreground="{DynamicResource MaterialDesignBody}">
  <UserControl.CommandBindings>
    <CommandBinding CanExecute="CanCloseDialog" Command="materialDesign:DialogHost.CloseDialogCommand" />
  </UserControl.CommandBindings>
  <Border Style="{StaticResource SettingsDialog}">
    <StackPanel>
      <TextBlock Text="Rename project" Style="{StaticResource SettingsSectionHeading}" />
      <Label Content="Project name" Target="{Binding ElementName=ProjectName}" Padding="0" FontWeight="SemiBold" Margin="0,0,0,6" />
      <TextBox x:Name="ProjectName" MinHeight="40" AutomationProperties.Name="Project name">
        <TextBox.Text>
          <Binding Path="Name" UpdateSourceTrigger="PropertyChanged">
            <Binding.ValidationRules><configuration:NotEmptyValidationRule /></Binding.ValidationRules>
          </Binding>
        </TextBox.Text>
      </TextBox>
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,24,0,0">
        <Button Content="Cancel" Click="CancelButtonClick" IsCancel="True" Margin="0,0,10,0"
                Command="materialDesign:DialogHost.CloseDialogCommand" Style="{StaticResource SettingsSecondaryButton}">
          <Button.CommandParameter><system:Boolean>False</system:Boolean></Button.CommandParameter>
        </Button>
        <Button Content="Save name" Click="OkButtonClick" IsDefault="True"
                Command="materialDesign:DialogHost.CloseDialogCommand" Style="{StaticResource SettingsPrimaryButton}">
          <Button.CommandParameter><system:Boolean>True</system:Boolean></Button.CommandParameter>
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
