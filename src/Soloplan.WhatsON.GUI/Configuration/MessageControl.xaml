<UserControl x:Class="Soloplan.WhatsON.GUI.Configuration.MessageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Soloplan.WhatsON.Localization;assembly=Soloplan.WhatsON"
             xmlns:live="clr-namespace:Soloplan.WhatsON.GUI.Common.Localization;assembly=Soloplan.WhatsON.GUI.Common"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             FontFamily="Segoe UI" FontSize="14" TextElement.Foreground="{DynamicResource MaterialDesignBody}">
  <Border Style="{StaticResource SettingsDialog}">
    <StackPanel>
      <TextBlock Text="{live:Text loc:Strings.UnableToLoadProjects}" Style="{StaticResource SettingsSectionHeading}" />
      <TextBlock x:Name="uxMessgeTextBox" TextWrapping="Wrap" Style="{StaticResource SettingsDescription}" />
      <Button Content="{live:Text loc:Strings.OK}" HorizontalAlignment="Right" Margin="0,24,0,0" IsDefault="True"
              Command="materialDesign:DialogHost.CloseDialogCommand" Style="{StaticResource SettingsPrimaryButton}">
        <Button.CommandParameter>
          <system:Boolean>True</system:Boolean>
        </Button.CommandParameter>
      </Button>
    </StackPanel>
  </Border>
</UserControl>