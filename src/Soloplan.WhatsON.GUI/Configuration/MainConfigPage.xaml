<Page x:Class="Soloplan.WhatsON.GUI.Configuration.MainConfigPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:Soloplan.WhatsON.Localization;assembly=Soloplan.WhatsON"
      xmlns:live="clr-namespace:Soloplan.WhatsON.GUI.Common.Localization;assembly=Soloplan.WhatsON.GUI.Common"
      xmlns:config="clr-namespace:Soloplan.WhatsON.Configuration;assembly=Soloplan.WhatsON"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="{live:Text loc:Strings.General}" FontFamily="Segoe UI" FontSize="14" Background="Transparent"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}">
  <ScrollViewer Style="{StaticResource SettingsPageScrollViewer}">
    <StackPanel Style="{StaticResource SettingsPageContent}">
      <TextBlock Text="{live:Text loc:Strings.General}" Style="{StaticResource SettingsHeading}" />
      <TextBlock Text="{live:Text loc:Strings.PersonalizeDescription}"
                 Style="{StaticResource SettingsIntro}" />
      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <TextBlock Text="{live:Text loc:Strings.Appearance}" Style="{StaticResource SettingsSectionHeading}" />
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition /><ColumnDefinition Width="190" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
              <TextBlock Text="{live:Text loc:Strings.Language}" FontWeight="SemiBold" />
              <TextBlock Text="{live:Text loc:Strings.LanguageChangeDescription}"
                         Style="{StaticResource SettingsDescription}" Margin="0,4,0,0" />
            </StackPanel>
            <ComboBox x:Name="LanguageSelector" Grid.Column="1" MinHeight="36" SelectedValuePath="Tag" SelectionChanged="LanguageSelectionChanged"
                      SelectedValue="{Binding Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      AutomationProperties.Name="{live:Text loc:Strings.Language}">
              <ComboBoxItem Content="{live:Text loc:Strings.System}" Tag="{x:Static config:ApplicationLanguage.System}" />
              <ComboBoxItem Content="English" Tag="{x:Static config:ApplicationLanguage.English}" />
              <ComboBoxItem Content="Deutsch" Tag="{x:Static config:ApplicationLanguage.German}" />
            </ComboBox>
          </Grid>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition /><ColumnDefinition Width="190" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
              <TextBlock Text="{live:Text loc:Strings.ColorTheme}" FontWeight="SemiBold" />
              <TextBlock Text="{live:Text loc:Strings.SystemThemeDescription}"
                         Style="{StaticResource SettingsDescription}" Margin="0,4,0,0" />
            </StackPanel>
            <ComboBox x:Name="ThemeModeSelector" Grid.Column="1" MinHeight="36"
                      SelectedValue="{Binding ThemeMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Tag" SelectionChanged="ThemeModeSelectionChanged"
                      AutomationProperties.Name="{live:Text loc:Strings.ColorTheme}">
              <ComboBoxItem Content="{live:Text loc:Strings.System}" Tag="{x:Static config:ApplicationTheme.System}" />
              <ComboBoxItem Content="{live:Text loc:Strings.Light}" Tag="{x:Static config:ApplicationTheme.Light}" />
              <ComboBoxItem Content="{live:Text loc:Strings.Dark}" Tag="{x:Static config:ApplicationTheme.Dark}" />
            </ComboBox>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition /><ColumnDefinition Width="190" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="{live:Text loc:Strings.BuildListDensity}" FontWeight="SemiBold" />
              <TextBlock Text="{live:Text loc:Strings.DensityDescription}" Style="{StaticResource SettingsDescription}"
                         Margin="0,4,0,0" />
            </StackPanel>
            <ComboBox Grid.Column="1" MinHeight="36" SelectedIndex="{Binding ViewStyle}"
                      AutomationProperties.Name="{live:Text loc:Strings.BuildListDensity}">
              <ComboBoxItem Content="{live:Text loc:Strings.Standard}" />
              <ComboBoxItem Content="{live:Text loc:Strings.Compact}" />
              <ComboBoxItem Content="{live:Text loc:Strings.Compressed}" />
            </ComboBox>
          </Grid>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <TextBlock Text="{live:Text loc:Strings.StartupAndWindow}" Style="{StaticResource SettingsSectionHeading}" />
          <DockPanel Margin="0,4,0,12">
            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding OpenOnSystemStart}"
                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                          AutomationProperties.Name="{live:Text loc:Strings.RunWhenWindowsStarts}" />
            <TextBlock Text="{live:Text loc:Strings.RunWhenWindowsStarts}" VerticalAlignment="Center" />
          </DockPanel>
          <DockPanel Margin="0,0,0,12">
            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding ShowInTaskbar}"
                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                          AutomationProperties.Name="{live:Text loc:Strings.ShowInTaskbar}" />
            <TextBlock Text="{live:Text loc:Strings.ShowInTaskbar}" VerticalAlignment="Center" />
          </DockPanel>
          <DockPanel Margin="0,0,0,12">
            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding AlwaysOnTop}"
                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                          AutomationProperties.Name="{live:Text loc:Strings.KeepWindowOnTop}" />
            <TextBlock Text="{live:Text loc:Strings.KeepWindowOnTop}" VerticalAlignment="Center" />
          </DockPanel>
          <DockPanel>
            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding OpenMinimized}"
                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                          AutomationProperties.Name="{live:Text loc:Strings.StartMinimized}" />
            <TextBlock Text="{live:Text loc:Strings.StartMinimized}" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <TextBlock Text="{live:Text loc:Strings.Notifications}" Style="{StaticResource SettingsSectionHeading}"
                     Margin="0,0,0,4" />
          <TextBlock Text="{live:Text loc:Strings.GlobalNotificationsDescription}"
                     Style="{StaticResource SettingsDescription}" Margin="0,0,0,16" />
          <UniformGrid Columns="3" Rows="2">
            <CheckBox Content="{live:Text loc:Strings.Unstable}" IsChecked="{Binding UnstableObservationState}"
                      Margin="0,0,12,12" />
            <CheckBox Content="{live:Text loc:Strings.Failure}" IsChecked="{Binding FailureObservationState}"
                      Margin="0,0,12,12" />
            <CheckBox Content="{live:Text loc:Strings.Success}" IsChecked="{Binding SuccessObservationState}"
                      Margin="0,0,0,12" />
            <CheckBox Content="{live:Text loc:Strings.Running}" IsChecked="{Binding RunningObservationState}"
                      Margin="0,0,12,12" />
            <CheckBox Content="{live:Text loc:Strings.Unknown}" IsChecked="{Binding UnknownObservationState}"
                      Margin="0,0,12,12" />
          </UniformGrid>
          <Border BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <DockPanel>
              <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding NotifyOnlyIfStatusChanged}"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}"
                            AutomationProperties.Name="{live:Text loc:Strings.NotifyOnlyWhenStatusChanges}" />
              <TextBlock Text="{live:Text loc:Strings.OnlyNotifyWhenStatusChanges}" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>