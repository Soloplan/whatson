<Page x:Class="Soloplan.WhatsON.GUI.Configuration.MainConfigPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:config="clr-namespace:Soloplan.WhatsON.Configuration;assembly=Soloplan.WhatsON"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="General" FontFamily="Segoe UI" FontSize="14" Background="Transparent" TextElement.Foreground="{DynamicResource MaterialDesignBody}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,16">
    <StackPanel>
      <TextBlock Text="General" Style="{StaticResource SettingsHeading}" />
      <TextBlock Text="Personalize your workspace and keep the right builds in view."
                 Style="{StaticResource SettingsDescription}" Margin="0,0,0,22" />
      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <TextBlock Text="Appearance" Style="{StaticResource SettingsSectionHeading}" />
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
              <TextBlock Text="Color theme" FontWeight="SemiBold" />
              <TextBlock Text="System follows your Windows appearance." Style="{StaticResource SettingsDescription}" Margin="0,4,0,0" />
            </StackPanel>
            <ComboBox x:Name="ThemeModeSelector" Grid.Column="1" MinHeight="36"
                      SelectedValue="{Binding ThemeMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Tag" SelectionChanged="ThemeModeSelectionChanged" AutomationProperties.Name="Color theme">
              <ComboBoxItem Content="System" Tag="{x:Static config:ApplicationTheme.System}" />
              <ComboBoxItem Content="Light" Tag="{x:Static config:ApplicationTheme.Light}" />
              <ComboBoxItem Content="Dark" Tag="{x:Static config:ApplicationTheme.Dark}" />
            </ComboBox>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
              <TextBlock Text="Build list density" FontWeight="SemiBold" />
              <TextBlock Text="Choose how much detail fits on screen." Style="{StaticResource SettingsDescription}" Margin="0,4,0,0" />
            </StackPanel>
            <ComboBox Grid.Column="1" MinHeight="36" SelectedIndex="{Binding ViewStyle}" AutomationProperties.Name="Build list density">
              <ComboBoxItem Content="Standard" />
              <ComboBoxItem Content="Compact" />
              <ComboBoxItem Content="Compressed" />
            </ComboBox>
          </Grid>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <TextBlock Text="Startup &amp; window" Style="{StaticResource SettingsSectionHeading}" />
          <DockPanel Margin="0,4,0,12">
            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding OpenOnSystemStart}"
                          Style="{StaticResource MaterialDesignSwitchToggleButton}" AutomationProperties.Name="Run when Windows starts" />
            <TextBlock Text="Run when Windows starts" VerticalAlignment="Center" />
          </DockPanel>
          <DockPanel Margin="0,0,0,12">
            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding ShowInTaskbar}"
                          Style="{StaticResource MaterialDesignSwitchToggleButton}" AutomationProperties.Name="Show in taskbar" />
            <TextBlock Text="Show in taskbar" VerticalAlignment="Center" />
          </DockPanel>
          <DockPanel Margin="0,0,0,12">
            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding AlwaysOnTop}"
                          Style="{StaticResource MaterialDesignSwitchToggleButton}" AutomationProperties.Name="Keep window on top" />
            <TextBlock Text="Keep window on top" VerticalAlignment="Center" />
          </DockPanel>
          <DockPanel>
            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding OpenMinimized}"
                          Style="{StaticResource MaterialDesignSwitchToggleButton}" AutomationProperties.Name="Start minimized" />
            <TextBlock Text="Start minimized" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <TextBlock Text="Notifications" Style="{StaticResource SettingsSectionHeading}" Margin="0,0,0,4" />
          <TextBlock Text="Global defaults. Each project can override these settings."
                     Style="{StaticResource SettingsDescription}" Margin="0,0,0,16" />
          <UniformGrid Columns="3" Rows="2">
            <CheckBox Content="Unstable" IsChecked="{Binding UnstableObservationState}" Margin="0,0,12,12" />
            <CheckBox Content="Failure" IsChecked="{Binding FailureObservationState}" Margin="0,0,12,12" />
            <CheckBox Content="Success" IsChecked="{Binding SuccessObservationState}" Margin="0,0,0,12" />
            <CheckBox Content="Running" IsChecked="{Binding RunningObservationState}" Margin="0,0,12,12" />
            <CheckBox Content="Unknown" IsChecked="{Binding UnknownObservationState}" Margin="0,0,12,12" />
          </UniformGrid>
          <Border BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <DockPanel>
              <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding NotifyOnlyIfStatusChanged}"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}" AutomationProperties.Name="Notify only when status changes" />
              <TextBlock Text="Only notify when status changes" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
