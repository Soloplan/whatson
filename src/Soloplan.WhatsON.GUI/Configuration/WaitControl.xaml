<UserControl x:Class="Soloplan.WhatsON.GUI.Configuration.WaitControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" FontSize="14" TextElement.Foreground="{DynamicResource MaterialDesignBody}">
  <Border Style="{StaticResource SettingsDialog}">
    <StackPanel Orientation="Horizontal">
      <ProgressBar Width="28" Height="28" Margin="0,0,16,0" IsIndeterminate="True"
                   Style="{StaticResource MaterialDesignCircularProgressBar}" AutomationProperties.Name="Loading projects" />
      <TextBlock Text="Loading projects…" VerticalAlignment="Center" FontWeight="SemiBold" />
    </StackPanel>
  </Border>
</UserControl>
