<Page x:Class="Soloplan.WhatsON.GUI.Configuration.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="About" FontFamily="Segoe UI" FontSize="14" Background="Transparent" TextElement.Foreground="{DynamicResource MaterialDesignBody}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,16">
    <StackPanel Margin="0,0,20,0">
      <TextBlock Text="About whatsON" Style="{StaticResource SettingsHeading}" />
      <TextBlock Text="Build monitoring that keeps your team informed." Style="{StaticResource SettingsDescription}" Margin="0,0,0,22" />
      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <DockPanel Margin="0,0,0,14">
            <Border DockPanel.Dock="Left" Background="{DynamicResource SettingsSelection}" CornerRadius="12" Padding="12" Margin="0,0,14,0">
              <materialDesign:PackIcon Kind="Monitor" Width="28" Height="28" Foreground="{DynamicResource SettingsAccent}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="whatsON" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Style="{StaticResource SettingsDescription}"><Run Text="Version " /><Run x:Name="VersionLabel" /></TextBlock>
            </StackPanel>
          </DockPanel>
          <TextBlock Margin="0,0,0,10">
            <Hyperlink NavigateUri="https://github.com/Soloplan/whatson" RequestNavigate="OpenLink"
                       Foreground="{DynamicResource SettingsAccent}" AutomationProperties.Name="Project website">Project website</Hyperlink>
            <Run Text="   ·   " />
            <Hyperlink NavigateUri="https://github.com/Soloplan/whatson/blob/master/LICENSE" RequestNavigate="OpenLink"
                       Foreground="{DynamicResource SettingsAccent}">MIT license</Hyperlink>
            <Run Text="   ·   " />
            <Hyperlink NavigateUri="https://github.com/Soloplan/whatson/issues" RequestNavigate="OpenLink"
                       Foreground="{DynamicResource SettingsAccent}" AutomationProperties.Name="Report an issue">Report an issue</Hyperlink>
          </TextBlock>
          <TextBlock Text="Created by Steffen Wilke, Dominik Gołda, Krzysztof Lorenc, and Christian Heidl."
                     Style="{StaticResource SettingsDescription}" Margin="0,0,0,8" />
          <TextBlock FontSize="12">
            <Hyperlink NavigateUri="https://www.soloplan.de" RequestNavigate="OpenLink"
                       Foreground="{DynamicResource SettingsAccent}">Made by Soloplan GmbH</Hyperlink>
          </TextBlock>
          <TextBlock Style="{StaticResource SettingsDescription}" Margin="0,12,0,0">
            <Run Text="Material Design in XAML " /><Run x:Name="MDIXVersionLabel" />
          </TextBlock>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <TextBlock Text="Configuration" Style="{StaticResource SettingsSectionHeading}" Margin="0,0,0,4" />
          <TextBlock Text="Back up your settings or restore them from a file."
                     Style="{StaticResource SettingsDescription}" Margin="0,0,0,12" />
          <TextBox x:Name="ConfigFile" IsReadOnly="True" MinHeight="36" FontSize="12"
                   AutomationProperties.Name="Configuration file location" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Import settings" Click="ImportButtonClick" Style="{StaticResource SettingsSecondaryButton}" Margin="0,0,10,0" />
            <Button Content="Export settings" Click="ExportButtonClick" Style="{StaticResource SettingsSecondaryButton}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <TextBlock Text="Installed plugins" Style="{StaticResource SettingsSectionHeading}" />
          <ListView x:Name="PluginList" BorderThickness="0" Background="Transparent" FontSize="13"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Installed plugins">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Margin" Value="0,2" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Version}" Style="{StaticResource SettingsDescription}" />
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}" Margin="0,4,0,0"
                             Style="{StaticResource SettingsDescription}" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
