<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>The library containing the GUI for the whatsON build and infrastructure monitoring tool.</Description>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Whatson.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Soloplan.WhatsON.GUI.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HtmlRenderer.WPF" />
    <PackageReference Include="Humanizer.Core" />
    <PackageReference Include="MaterialDesignThemes" />
    <PackageReference Include="NLog" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Soloplan.WhatsON.GUI.Common\Soloplan.WhatsON.GUI.Common.csproj" />
    <ProjectReference Include="..\Soloplan.WhatsON\Soloplan.WhatsON.csproj" />
    <ProjectReference Include="..\Soloplan.WhatsON.Jenkins.GUI\Soloplan.WhatsON.Jenkins.GUI.csproj" />
    <ProjectReference Include="..\Soloplan.WhatsON.CruiseControl.GUI\Soloplan.WhatsON.CruiseControl.GUI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Whatson.ico" />
    <Resource Include="Logging\LogConfig.xml" />
    <Resource Include="Resources\whatsONx16.png" />
    <EmbeddedResource Update="Properties\Resources.resx" Generator="PublicResXFileCodeGenerator" LastGenOutput="Resources.Designer.cs" />
    <EmbeddedResource Update="Properties\ConfigurationItems.resx" Generator="ResXFileCodeGenerator" LastGenOutput="ConfigurationItems.Designer.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fody" PrivateAssets="all" />
    <PackageReference Include="PropertyChanged.Fody" PrivateAssets="all" />
  </ItemGroup>
</Project>
