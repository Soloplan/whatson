<Window x:Class="Soloplan.WhatsON.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Soloplan.WhatsON.Localization;assembly=Soloplan.WhatsON"
        xmlns:live="clr-namespace:Soloplan.WhatsON.GUI.Common.Localization;assembly=Soloplan.WhatsON.GUI.Common"
        xmlns:connectorTreeView="clr-namespace:Soloplan.WhatsON.GUI.Common.ConnectorTreeView;assembly=Soloplan.WhatsON.GUI.Common"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Soloplan.WhatsON.GUI"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="whatsON"
        Width="800"
        Height="450"
        MinWidth="300"
        MinHeight="200"
        Background="{DynamicResource SettingsBackground}"
        FontFamily="Segoe UI"
        Style="{StaticResource BorderLessWindowStyle}"
        TextElement.FontSize="14"
        TextElement.FontWeight="Normal"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        mc:Ignorable="d">
  <Window.CommandBindings>
    <CommandBinding Command="New" Executed="AddJobToGroupExecuted" CanExecute="AddJobToGroupCanExecute" />
  </Window.CommandBindings>
  <Window.Resources>
    <ResourceDictionary>
      <Storyboard x:Key="hideStorBoard">
        <DoubleAnimation Storyboard.TargetName="HideableStackPanel"
                         Storyboard.TargetProperty="RenderTransform.Y"
                         From="0"
                         To="100"
                         Duration="0:00:.300" />
      </Storyboard>

      <Storyboard x:Key="showStoryBoard">
        <DoubleAnimation Storyboard.TargetName="HideableStackPanel"
                         Storyboard.TargetProperty="RenderTransform.Y"
                         From="100"
                         To="0"
                         Duration="0:00:.300" />
      </Storyboard>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel Background="{DynamicResource SettingsBackground}">
    <local:CustomTitleBar
      AddConnectorClicked="NewConnectorClickAsync"
      AddGroupClicked="NewGroupClickAsync"
      ButtonClicked="OpenConfig"
      CustomButtonIcon="SettingsOutline"
      CustomButtonVisible="{Binding ConfigurationModifiedFromTree, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Converter={StaticResource InvertBoolConverter}}"
      DockPanel.Dock="Top"
      ImportClicked="ImportClickAsync"
      ShowMinimizeButton="{Binding Path=ShowInTaskbar, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}"
      Window="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" />

    <Border x:Name="HideableStackPanel"
            Padding="8,8,8,8"
            DockPanel.Dock="Bottom"
            Visibility="{Binding ConfigurationModifiedFromTree, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Converter={StaticResource BoolToVis}}">
      <materialDesign:ColorZone x:Name="ConfigurationChangesBanner" Mode="Standard"
                                Background="{DynamicResource SettingsSurface}"
                                Foreground="{DynamicResource MaterialDesignBody}">
        <DockPanel LastChildFill="False">
          <TextBlock Padding="5"
                     VerticalAlignment="Center"
                     Text="{live:Text loc:Strings.ConfigurationIsModified}" />
          <DockPanel DockPanel.Dock="Right">
            <Button Margin="5" Padding="5" Click="SaveClickAsync" Style="{StaticResource SettingsPrimaryButton}"
                    Content="{live:Text loc:Strings.Save}" />
            <Button Margin="5" Padding="5" Click="ResetClick" Style="{StaticResource SettingsSecondaryButton}"
                    Content="{live:Text loc:Strings.Reset}" />
          </DockPanel>
        </DockPanel>
      </materialDesign:ColorZone>
      <Border.RenderTransform>
        <TranslateTransform Y="0" />
      </Border.RenderTransform>
    </Border>

    <materialDesign:DialogHost DockPanel.Dock="Bottom" Identifier="MainWindowPageHost">
      <Grid>
        <connectorTreeView:ConnectorsTreeView x:Name="mainTreeView"
                                              Margin="12,8,8,12"
                                              HorizontalAlignment="Stretch" />
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="18"
                   FontWeight="Bold"
                   Text="{live:Text loc:Strings.Loading}"
                   Visibility="{Binding IsTreeInitialized, Converter={StaticResource InvertBoolToVis}}" />
      </Grid>
    </materialDesign:DialogHost>
  </DockPanel>
</Window>
