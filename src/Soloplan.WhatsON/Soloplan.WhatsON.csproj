<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>The core library for the whatsON build and infrastructure monitoring tool.</Description>
    <IsPackable>true</IsPackable>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/Soloplan/whatson</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Soloplan/whatson</RepositoryUrl>
    <PackageTags>monitoring, jenkins, tray-application, build-jobs, dektop-notifications</PackageTags>
    <PackageVersion>1.0.0-RC8</PackageVersion>
    <PackageIcon>whatson-icon.png</PackageIcon>
    <Authors>Steffen Wilke, Krzysztof Lorenc, Dominik Gołda</Authors>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <LocalizationSource>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\Strings.g.cs</LocalizationSource>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Soloplan.WhatsON.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="NLog" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.resx"
                      StronglyTypedLanguage="CSharp"
                      StronglyTypedNamespace="Soloplan.WhatsON.Localization"
                      StronglyTypedClassName="Strings"
                      StronglyTypedFileName="$(LocalizationSource)"
                      PublicClass="true" />
    <Compile Include="$(LocalizationSource)" AutoGen="true" DesignTime="true" Visible="false" />
  </ItemGroup>
  <!-- IDEs need the source during evaluation; CoreResGen adds it again during a build. -->
  <Target Name="PrepareLocalizationSource" BeforeTargets="CoreResGen">
    <ItemGroup>
      <Compile Remove="$(LocalizationSource)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Update="whatson-icon.png" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
