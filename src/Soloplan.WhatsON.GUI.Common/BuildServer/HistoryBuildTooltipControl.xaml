<UserControl x:Class="Soloplan.WhatsON.GUI.Common.BuildServer.HistoryBuildTooltipControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Soloplan.WhatsON.Localization;assembly=Soloplan.WhatsON"
             xmlns:live="clr-namespace:Soloplan.WhatsON.GUI.Common.Localization"
             xmlns:converters="clr-namespace:Soloplan.WhatsON.GUI.Common.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
  <UserControl.Resources>
    <converters:TimeToApproximateTimeConverter x:Key="RelativeTime" />
    <converters:NullOrDefaultToVisibilityConverter x:Key="HasValue" />
    <Style TargetType="materialDesign:PackIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Margin" Value="0,2,7,0" />
      <Setter Property="Foreground" Value="{DynamicResource SettingsMuted}" />
      <Setter Property="DockPanel.Dock" Value="Left" />
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <DockPanel Visibility="{Binding Label, Converter={StaticResource HasValue}}">
      <materialDesign:PackIcon Kind="TagOutline" />
      <TextBlock FontWeight="SemiBold" Text="{Binding Label}" TextWrapping="Wrap" />
    </DockPanel>
    <DockPanel Margin="0,4,0,0" Visibility="{Binding Duration, Converter={StaticResource HasValue}}">
      <materialDesign:PackIcon Kind="TimerOutline" />
      <TextBlock Text="{live:Text loc:Strings.DurationPrefix}" DockPanel.Dock="Left" />
      <TextBlock>
        <TextBlock.Text>
          <MultiBinding StringFormat="{}{0:00}:{1:00}:{2:00}">
            <Binding Path="Duration.Hours" /><Binding Path="Duration.Minutes" /><Binding Path="Duration.Seconds" />
          </MultiBinding>
        </TextBlock.Text>
      </TextBlock>
    </DockPanel>
    <DockPanel Margin="0,4,0,0" Visibility="{Binding Time, Converter={StaticResource HasValue}}">
      <materialDesign:PackIcon Kind="CheckCircleOutline" />
      <TextBlock Text="{live:Text loc:Strings.FinishedPrefix}" DockPanel.Dock="Left" />
      <TextBlock TextWrapping="Wrap">
        <TextBlock.Text>
          <MultiBinding Converter="{StaticResource RelativeTime}">
            <Binding Path="FinishTime" />
            <Binding Path="Culture" Source="{x:Static live:LanguageSource.Instance}" />
          </MultiBinding>
        </TextBlock.Text>
      </TextBlock>
    </DockPanel>
    <DockPanel Margin="0,4,0,0" Visibility="{Binding Time, Converter={StaticResource HasValue}}">
      <materialDesign:PackIcon Kind="CalendarOutline" />
      <TextBlock Text="{Binding Time}" Foreground="{DynamicResource SettingsMuted}" TextWrapping="Wrap" />
    </DockPanel>
  </StackPanel>
</UserControl>
