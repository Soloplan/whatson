<UserControl x:Class="Soloplan.WhatsON.GUI.Common.BuildServer.HistoryBuildControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Soloplan.WhatsON.Localization;assembly=Soloplan.WhatsON"
             xmlns:live="clr-namespace:Soloplan.WhatsON.GUI.Common.Localization"
             xmlns:connectorTreeView="clr-namespace:Soloplan.WhatsON.GUI.Common.ConnectorTreeView"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:Soloplan.WhatsON.GUI.Common.BuildServer"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="clr-namespace:System;assembly=mscorlib"
             xmlns:common="clr-namespace:Soloplan.WhatsON.GUI.Common"
             xmlns:converters="clr-namespace:Soloplan.WhatsON.GUI.Common.Converters"
             d:DataContext="{d:DesignInstance local:BuildStatusViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="800"
             ToolTipService.ShowDuration="{x:Static s:Int32.MaxValue}"
             mc:Ignorable="d"
             materialDesign:TransitionAssist.DisableTransitions="True">
  <UserControl.Resources>
    <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
    <converters:NullOrDefaultToVisibilityConverter x:Key="HasVolunteerCommand" />
    <ContextMenu x:Key="ContextMenuBuild">
      <MenuItem Visibility="{Binding VolunteerToFix, Converter={StaticResource HasVolunteerCommand}}">
        <MenuItem.HeaderTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Kind="AccountWrench" />
              <TextBlock Padding="10,0,0,0" Text="{Binding}" />
            </StackPanel>
          </DataTemplate>
        </MenuItem.HeaderTemplate>
        <MenuItem.Style>
          <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{live:Text loc:Strings.ClearVolunteer}" />
            <Setter Property="Command" Value="{Binding ClearVolunteer}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Volunteer}" Value="{x:Null}">
                <Setter Property="Header" Value="{live:Text loc:Strings.VolunteerToFix}" />
                <Setter Property="Command" Value="{Binding VolunteerToFix}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </MenuItem.Style>
      </MenuItem>
      <Separator Visibility="{Binding VolunteerToFix, Converter={StaticResource HasVolunteerCommand}}" />
      <MenuItem CommandParameter="{Binding}" Command="{Binding CopyBuildLabel}">
        <MenuItem.Header>
          <StackPanel Orientation="Horizontal">
            <materialDesign:PackIcon Kind="TagOutline" />
            <TextBlock Padding="10,0,0,0" Text="{live:Text loc:Strings.CopyBuildLabel}" />
          </StackPanel>
        </MenuItem.Header>
      </MenuItem>
      <MenuItem CommandParameter="{Binding Url}" Command="{Binding OpenBuildPage}">
        <MenuItem.Header>
          <StackPanel Orientation="Horizontal">
            <materialDesign:PackIcon Kind="Link" />
            <TextBlock Padding="10,0,0,0" Text="{live:Text loc:Strings.OpenBuildWebsite}" />
          </StackPanel>
        </MenuItem.Header>
      </MenuItem>
    </ContextMenu>
  </UserControl.Resources>
  <DockPanel ContextMenu="{StaticResource ContextMenuBuild}">
    <Button Width="16"
            Height="24"
            Padding="0"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            VerticalAlignment="Center">
      <i:Interaction.Triggers>
        <!--  Handle clicking on history builds.  -->
        <i:EventTrigger EventName="Click">
          <i:InvokeCommandAction CommandParameter="{Binding Url}" Command="{Binding OpenBuildPage}" />
        </i:EventTrigger>
      </i:Interaction.Triggers>
      <Ellipse Width="{Binding Size}"
               Height="{Binding Size}"
               Fill="{Binding Mode=OneWay, Converter={StaticResource StatusToColorConverter}}" />
    </Button>
  </DockPanel>
</UserControl>
