<UserControl x:Class="Soloplan.WhatsON.GUI.Common.BuildServer.FailureDetailsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Soloplan.WhatsON.Localization;assembly=Soloplan.WhatsON"
             xmlns:live="clr-namespace:Soloplan.WhatsON.GUI.Common.Localization"
             xmlns:converters="clr-namespace:Soloplan.WhatsON.GUI.Common.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
  <UserControl.Resources>
    <converters:NullOrDefaultToVisibilityConverter x:Key="HasValue" />
    <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="{live:Text loc:Strings.Loading}" Margin="0,10,0,0" Foreground="{DynamicResource SettingsMuted}"
               Visibility="{Binding IsLoadingFailureDetails, Converter={StaticResource VisibleWhenTrue}}" />
    <Border Background="{DynamicResource TooltipFailureSurface}" BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="0,1,0,0"
            CornerRadius="0,0,9,9" Padding="18,14,18,16" Margin="-18,16,-18,-16"
            Visibility="{Binding HasFailurePreview, Converter={StaticResource VisibleWhenTrue}}">
      <StackPanel>
        <DockPanel Visibility="{Binding FailurePreviewHeading, Converter={StaticResource HasValue}}">
          <materialDesign:PackIcon Kind="CloseCircleOutline" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TooltipError}" DockPanel.Dock="Left" />
          <TextBlock Text="{Binding FailurePreviewHeading}" Foreground="{DynamicResource TooltipError}" FontWeight="Medium" VerticalAlignment="Center" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding FailurePreviewGroups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,10,0,0">
                <TextBlock Text="{Binding Key}" FontWeight="Medium" TextWrapping="Wrap" LineHeight="19.5" MaxHeight="39"
                           Visibility="{Binding Key, Converter={StaticResource HasValue}}" />
                <ItemsControl ItemsSource="{Binding}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" FontFamily="Cascadia Code, Consolas" FontSize="12" Margin="0,3,0,0"
                                 Foreground="{DynamicResource SettingsMuted}" TextWrapping="Wrap" LineHeight="18" MaxHeight="54" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding MoreFailuresPreview}" Margin="0,11,0,0" FontSize="12" Foreground="{DynamicResource SettingsMuted}"
                   Visibility="{Binding MoreFailuresPreview, Converter={StaticResource HasValue}}" />
        <Border BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0"
                Visibility="{Binding WarningPreview, Converter={StaticResource HasValue}}">
          <DockPanel>
            <materialDesign:PackIcon Kind="AlertOutline" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TooltipWarning}" DockPanel.Dock="Left" />
            <TextBlock Text="{Binding WarningPreview}" FontSize="12" Foreground="{DynamicResource SettingsMuted}" TextWrapping="Wrap" MaxHeight="54" VerticalAlignment="Center" />
          </DockPanel>
        </Border>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
